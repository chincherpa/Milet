<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Milet.Infrastructure</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Design-Time-Projekt für "dotnet ef" (s. CLAUDE.md: WinUI kann diese Rolle nicht übernehmen).
         Die Version steht wie alle anderen in Directory.Packages.props; sie war dort schon gepinnt, aber von
         keinem Projekt referenziert — "dotnet ef migrations add" scheiterte aus einem frischen Checkout mit
         "doesn't reference Microsoft.EntityFrameworkCore.Design". PrivateAssets: reines Build-Werkzeug,
         gehört nicht in die Ausgabe von Milet.App. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="Microsoft.Graph" />
    <PackageReference Include="Microsoft.Identity.Client.Broker" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Milet.Application\Milet.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Milet.IntegrationTests" />
  </ItemGroup>
</Project>
