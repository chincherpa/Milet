<Window
    x:Class="Milet.App.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Milet Warenwirtschaft — Anmeldung">
    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="360"
            Spacing="12">
            <TextBlock Text="Milet Warenwirtschaft" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" Margin="0,0,0,12" />
            <TextBox x:Name="BenutzernameBox" Header="Benutzername" Text="{x:Bind ViewModel.Benutzername, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.SchemaAktuell, Mode=OneWay}" />
            <PasswordBox x:Name="PasswortBox" Header="Passwort" PasswordChanged="PasswortBox_PasswordChanged" IsEnabled="{x:Bind ViewModel.SchemaAktuell, Mode=OneWay}" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.Fehlermeldung, Mode=OneWay, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                Severity="Error"
                Message="{x:Bind ViewModel.Fehlermeldung, Mode=OneWay}" />
            <Button
                Content="Anmelden"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.AnmeldenCommand}"
                IsEnabled="{x:Bind ViewModel.SchemaAktuell, Mode=OneWay}" />
            <ProgressRing IsActive="{x:Bind ViewModel.AnmeldungLaeuft, Mode=OneWay}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
