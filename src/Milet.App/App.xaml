<Application
    x:Class="Milet.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Milet.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Farben.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:StringNotEmptyToBoolConverter x:Key="StringNotEmptyToBoolConverter" />
            <conv:DecimalToDoubleConverter x:Key="DecimalToDoubleConverter" />
            <conv:DateOnlyToDateTimeOffsetConverter x:Key="DateOnlyToDateTimeOffsetConverter" />
            <conv:NullableInt32ToDoubleConverter x:Key="NullableInt32ToDoubleConverter" />
            <conv:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:AmpelToColorConverter x:Key="AmpelToColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
