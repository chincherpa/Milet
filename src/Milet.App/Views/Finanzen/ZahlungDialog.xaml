<ContentDialog
    x:Class="Milet.App.Views.Finanzen.ZahlungDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Milet.App.Views.Finanzen"
    Title="Zahlung erfassen"
    PrimaryButtonText="Zahlung erfassen"
    CloseButtonText="Abbrechen"
    DefaultButton="Primary">
    <StackPanel Spacing="12" MinWidth="560">
        <DatePicker Header="Zahlungsdatum" Date="{x:Bind Zahlungsdatum, Mode=TwoWay}" />
        <TextBox Header="Zahlungsart" Text="{x:Bind Zahlungsart, Mode=TwoWay}" PlaceholderText="z. B. Überweisung" />
        <TextBox Header="Referenz" Text="{x:Bind Referenz, Mode=TwoWay}" PlaceholderText="optional" />
        <TextBlock Text="Zuordnung zu offenen Posten (Skonto-Vorschlag bereits vorausgefüllt, editierbar):" />
        <ListView MaxHeight="320" ItemsSource="{x:Bind Zeilen}">
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="12" Padding="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="100" />
                            <ColumnDefinition Width="120" /><ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Beleg" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Offen" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Betrag" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Skonto" FontWeight="SemiBold" />
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ZahlungZeile">
                    <Grid ColumnSpacing="12" Padding="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="100" />
                            <ColumnDefinition Width="120" /><ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind BelegNummer}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind OffenerBetrag}" VerticalAlignment="Center" />
                        <NumberBox Grid.Column="2" Minimum="0" SpinButtonPlacementMode="Compact"
                                   Value="{x:Bind Betrag, Mode=TwoWay, Converter={StaticResource DecimalToDoubleConverter}}" />
                        <NumberBox Grid.Column="3" Minimum="0" SpinButtonPlacementMode="Compact"
                                   Value="{x:Bind SkontoBetrag, Mode=TwoWay, Converter={StaticResource DecimalToDoubleConverter}}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
