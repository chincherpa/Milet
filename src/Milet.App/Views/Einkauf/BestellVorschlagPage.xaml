<Page
    x:Class="Milet.App.Views.Einkauf.BestellVorschlagPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Bestellvorschlag" Style="{StaticResource TitleTextBlockStyle}" />

        <!-- Supplier Selection -->
        <ComboBox Grid.Row="1" Header="Lieferant *"
            ItemsSource="{x:Bind ViewModel.Lieferanten, Mode=OneWay}"
            SelectedValue="{x:Bind ViewModel.LieferantId, Mode=TwoWay}"
            SelectedValuePath="Id"
            DisplayMemberPath="Anzeige"
            HorizontalAlignment="Stretch"
            MaxWidth="400" />

        <!-- Error & Loading -->
        <StackPanel Grid.Row="2" Spacing="12">
            <InfoBar IsOpen="{x:Bind ViewModel.Fehlermeldung, Mode=OneWay, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                Severity="Error" Title="Fehler" Message="{x:Bind ViewModel.Fehlermeldung, Mode=OneWay}" />
            <ProgressRing IsActive="{x:Bind ViewModel.LaedtGerade, Mode=OneWay}" Width="24" Height="24" />
        </StackPanel>

        <!-- List of Items -->
        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Zeilen, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <!-- Checkbox -->
                        <CheckBox Grid.Column="0" IsChecked="{Binding Ausgewaehlt, Mode=TwoWay}" VerticalAlignment="Center" />

                        <!-- Artikelnummer -->
                        <TextBlock Grid.Column="1" Text="{Binding Artikelnummer}" VerticalAlignment="Center" />

                        <!-- Bezeichnung -->
                        <TextBlock Grid.Column="2" Text="{Binding Bezeichnung}" VerticalAlignment="Center" />

                        <!-- AktuellerBestand -->
                        <TextBlock Grid.Column="3" Text="{Binding AktuellerBestand}" VerticalAlignment="Center" />

                        <!-- Mindestbestand -->
                        <TextBlock Grid.Column="4" Text="{Binding Mindestbestand}" VerticalAlignment="Center" />

                        <!-- Menge -->
                        <NumberBox Grid.Column="5" Value="{Binding Menge, Mode=TwoWay, Converter={StaticResource DecimalToDoubleConverter}}" Minimum="0" SpinButtonPlacementMode="Compact" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid Padding="8,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Nummer" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Bezeichnung" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Aktuell" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="Minimum" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="Menge" FontWeight="SemiBold" />
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>
        </ListView>

        <!-- Action Button -->
        <Button Grid.Row="4" Content="Bestellung erzeugen"
            Style="{StaticResource AccentButtonStyle}"
            Command="{x:Bind ViewModel.BestellungErzeugenCommand}"
            HorizontalAlignment="Left" />
    </Grid>
</Page>
