<Page
    x:Class="Milet.App.Views.Gaertnerei.PflanzenUebersichtPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" ColumnSpacing="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Pflanzenübersicht" Style="{StaticResource TitleTextBlockStyle}" />

        <Grid Grid.Row="1" Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0" PlaceholderText="Pflanze suchen (Name, Artikelnummer, botanischer Name)..." Text="{x:Bind ViewModel.Suchtext, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Pflanzen, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.AusgewaehltePflanze, Mode=TwoWay}" SelectionMode="Single"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="2" Padding="8,6">
                            <TextBlock Text="{Binding Bezeichnung}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding BotanischerName}" FontStyle="Italic" Opacity="0.7" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Gesamt:" Opacity="0.7" FontSize="12" />
                                <TextBlock Text="{Binding GesamtMenge}" FontSize="12" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding JeStufe}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding FarbeHex, Converter={StaticResource HexColorToBrushConverter}}" CornerRadius="8" Padding="6,2">
                                            <TextBlock Text="{Binding Menge}" FontSize="11"
                                                       Foreground="{Binding FarbeHex, Converter={StaticResource KontrastFarbeConverter}}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16">
                <ToggleSwitch Header="Nur verkaufsfähige Stufen" IsOn="{x:Bind ViewModel.NurVerkaufsfaehigeAnzeigen, Mode=TwoWay}" />
                <ComboBox Header="Stufenfilter" Width="220" ItemsSource="{x:Bind ViewModel.Kulturstufen, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.StufenFilterId, Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="Bezeichnung" PlaceholderText="Alle Stufen" />
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <TextBlock Text="Zoom" VerticalAlignment="Center" Opacity="0.7" />
                    <Slider Width="160" Minimum="5" Maximum="60" Value="{x:Bind ViewModel.Zoom, Mode=TwoWay}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="1" ZoomMode="Disabled" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <Canvas x:Name="PlanCanvas" Background="Transparent"
                        Width="{x:Bind ViewModel.PlanPixelBreite, Mode=OneWay}"
                        Height="{x:Bind ViewModel.PlanPixelHoehe, Mode=OneWay}" />
            </ScrollViewer>

            <ItemsControl Grid.Row="2" ItemsSource="{x:Bind ViewModel.Kulturstufen, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="16" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="14" Height="14" CornerRadius="3" Background="{Binding FarbeHex, Converter={StaticResource HexColorToBrushConverter}}" />
                            <TextBlock Text="{Binding Bezeichnung}" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Fundstellen, Mode=OneWay}" SelectionMode="None"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid Padding="8,4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Feld" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Sektion" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Stufe" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Menge" FontWeight="SemiBold" />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8,4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding FeldBezeichnung}" />
                            <TextBlock Grid.Column="1" Text="{Binding SektionBezeichnung}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="12" CornerRadius="3" Background="{Binding FarbeHex, Converter={StaticResource HexColorToBrushConverter}}" />
                                <TextBlock Text="{Binding StufeBezeichnung}" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding Menge}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
