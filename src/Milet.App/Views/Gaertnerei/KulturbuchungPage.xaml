<Page
    x:Class="Milet.App.Views.Gaertnerei.KulturbuchungPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" ColumnSpacing="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Kulturbuchungen" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="8">
            <ComboBox Header="Pflanze *" Width="360" HorizontalAlignment="Left"
                      ItemsSource="{x:Bind ViewModel.Pflanzen, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.AusgewaehltePflanze, Mode=TwoWay}"
                      DisplayMemberPath="Bezeichnung" PlaceholderText="Pflanze wählen..." />
            <InfoBar IsOpen="{x:Bind ViewModel.Fehler, Mode=OneWay, Converter={StaticResource StringNotEmptyToBoolConverter}}" Severity="Error" Title="Fehler" Message="{x:Bind ViewModel.Fehler, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.Erfolg, Mode=OneWay, Converter={StaticResource StringNotEmptyToBoolConverter}}" Severity="Success" Title="Erfolg" Message="{x:Bind ViewModel.Erfolg, Mode=OneWay}" />
        </StackPanel>

        <Pivot Grid.Row="2" Grid.Column="0">

            <PivotItem Header="Zugang">
                <StackPanel Spacing="12" MaxWidth="420" HorizontalAlignment="Left">
                    <TextBlock Text="Erstzugang einer Kultur (Anzucht/Aussaat) — Feld/Sektion/Stufe frei wählbar." Opacity="0.7" TextWrapping="Wrap" />
                    <ComboBox Header="Feld *" ItemsSource="{x:Bind ViewModel.Felder, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.ZugangFeldId, Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="Bezeichnung" HorizontalAlignment="Stretch" />
                    <ComboBox Header="Sektion" ItemsSource="{x:Bind ViewModel.ZugangSektionen, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.ZugangSektionId, Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="Bezeichnung" HorizontalAlignment="Stretch" PlaceholderText="(Feld ohne Sektionen)" />
                    <ComboBox Header="Kulturstufe *" ItemsSource="{x:Bind ViewModel.Kulturstufen, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.ZugangKulturstufeId, Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="Bezeichnung" HorizontalAlignment="Stretch" />
                    <NumberBox Header="Menge *" Value="{x:Bind ViewModel.ZugangMenge, Mode=TwoWay, Converter={StaticResource DecimalToDoubleConverter}}" Minimum="0" />
                    <DatePicker Header="Datum" Date="{x:Bind ViewModel.ZugangDatum, Mode=TwoWay, Converter={StaticResource DateOnlyToDateTimeOffsetConverter}}" />
                    <TextBox Header="Bemerkung" Text="{x:Bind ViewModel.ZugangBemerkung, Mode=TwoWay}" />
                    <Button Content="Zugang buchen" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.ZugangBuchenCommand}" />
                </StackPanel>
            </PivotItem>

            <PivotItem Header="Stufenwechsel">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="Quelle (vorhandener Bestand) *" FontWeight="SemiBold" />
                        <ListView ItemsSource="{x:Bind ViewModel.Vorkommen, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.AusgewaehlteQuelle, Mode=TwoWay}" SelectionMode="Single"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Height="240">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="6,4">
                                        <TextBlock Text="{Binding FeldBezeichnung}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock FontSize="12" Opacity="0.8">
                                            <Run Text="{Binding SektionBezeichnung}" />
                                            <Run Text=" — " />
                                            <Run Text="{Binding StufeBezeichnung}" />
                                            <Run Text=": " />
                                            <Run Text="{Binding Menge}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="12" MaxWidth="420" HorizontalAlignment="Left">
                        <ComboBox Header="Ziel-Feld *" ItemsSource="{x:Bind ViewModel.Felder, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.NachFeldIdStufenwechsel, Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="Bezeichnung" HorizontalAlignment="Stretch" />
                        <ComboBox Header="Ziel-Sektion" ItemsSource="{x:Bind ViewModel.NachSektionenStufenwechsel, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.NachSektionIdStufenwechsel, Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="Bezeichnung" HorizontalAlignment="Stretch" />
                        <ComboBox Header="Ziel-Kulturstufe *" ItemsSource="{x:Bind ViewModel.Kulturstufen, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.NachKulturstufeId, Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="Bezeichnung" HorizontalAlignment="Stretch" />
                        <NumberBox Header="Menge *" Value="{x:Bind ViewModel.MengeStufenwechsel, Mode=TwoWay, Converter={StaticResource DecimalToDoubleConverter}}" Minimum="0" />
                        <DatePicker Header="Datum" Date="{x:Bind ViewModel.DatumStufenwechsel, Mode=TwoWay, Converter={StaticResource DateOnlyToDateTimeOffsetConverter}}" />
                        <TextBox Header="Bemerkung" Text="{x:Bind ViewModel.BemerkungStufenwechsel, Mode=TwoWay}" />
                        <Button Content="Stufenwechsel buchen" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.StufenwechselBuchenCommand}" />
                    </StackPanel>
                </Grid>
            </PivotItem>

            <PivotItem Header="Umsetzen">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="Quelle (vorhandener Bestand) *" FontWeight="SemiBold" />
                        <ListView ItemsSource="{x:Bind ViewModel.Vorkommen, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.AusgewaehlteQuelle, Mode=TwoWay}" SelectionMode="Single"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Height="240">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="6,4">
                                        <TextBlock Text="{Binding FeldBezeichnung}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock FontSize="12" Opacity="0.8">
                                            <Run Text="{Binding SektionBezeichnung}" />
                                            <Run Text=" — " />
                                            <Run Text="{Binding StufeBezeichnung}" />
                                            <Run Text=": " />
                                            <Run Text="{Binding Menge}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="12" MaxWidth="420" HorizontalAlignment="Left">
                        <TextBlock Text="Stufe bleibt gleich — nur der Ort ändert sich." Opacity="0.7" TextWrapping="Wrap" />
                        <ComboBox Header="Ziel-Feld *" ItemsSource="{x:Bind ViewModel.Felder, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.NachFeldIdUmsetzen, Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="Bezeichnung" HorizontalAlignment="Stretch" />
                        <ComboBox Header="Ziel-Sektion" ItemsSource="{x:Bind ViewModel.NachSektionenUmsetzen, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.NachSektionIdUmsetzen, Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="Bezeichnung" HorizontalAlignment="Stretch" />
                        <NumberBox Header="Menge *" Value="{x:Bind ViewModel.MengeUmsetzen, Mode=TwoWay, Converter={StaticResource DecimalToDoubleConverter}}" Minimum="0" />
                        <DatePicker Header="Datum" Date="{x:Bind ViewModel.DatumUmsetzen, Mode=TwoWay, Converter={StaticResource DateOnlyToDateTimeOffsetConverter}}" />
                        <TextBox Header="Bemerkung" Text="{x:Bind ViewModel.BemerkungUmsetzen, Mode=TwoWay}" />
                        <Button Content="Umsetzen buchen" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.UmsetzenBuchenCommand}" />
                    </StackPanel>
                </Grid>
            </PivotItem>

            <PivotItem Header="Ausfall">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="Betroffene Fundstelle *" FontWeight="SemiBold" />
                        <ListView ItemsSource="{x:Bind ViewModel.Vorkommen, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.AusgewaehlteQuelle, Mode=TwoWay}" SelectionMode="Single"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Height="240">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="6,4">
                                        <TextBlock Text="{Binding FeldBezeichnung}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock FontSize="12" Opacity="0.8">
                                            <Run Text="{Binding SektionBezeichnung}" />
                                            <Run Text=" — " />
                                            <Run Text="{Binding StufeBezeichnung}" />
                                            <Run Text=": " />
                                            <Run Text="{Binding Menge}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="12" MaxWidth="420" HorizontalAlignment="Left">
                        <NumberBox Header="Ausfallmenge *" Value="{x:Bind ViewModel.MengeAusfall, Mode=TwoWay, Converter={StaticResource DecimalToDoubleConverter}}" Minimum="0" />
                        <DatePicker Header="Datum" Date="{x:Bind ViewModel.DatumAusfall, Mode=TwoWay, Converter={StaticResource DateOnlyToDateTimeOffsetConverter}}" />
                        <TextBox Header="Bemerkung (Ursache)" Text="{x:Bind ViewModel.BemerkungAusfall, Mode=TwoWay}" />
                        <Button Content="Ausfall buchen" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.AusfallBuchenCommand}" />
                    </StackPanel>
                </Grid>
            </PivotItem>

        </Pivot>

        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="8">
            <TextBlock Text="Kulturhistorie" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView ItemsSource="{x:Bind ViewModel.Historie, Mode=OneWay}" SelectionMode="None"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="6,4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Zeitpunkt}" FontSize="11" Opacity="0.7" />
                                <TextBlock Text="{Binding Typ}" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="{Binding Menge}" FontSize="12" />
                            </StackPanel>
                            <TextBlock FontSize="11" Opacity="0.8">
                                <Run Text="{Binding FeldBezeichnung}" />
                                <Run Text=" / " />
                                <Run Text="{Binding SektionBezeichnung}" />
                                <Run Text=" — " />
                                <Run Text="{Binding StufeBezeichnung}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
