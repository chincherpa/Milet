<Page
    x:Class="Milet.App.Views.Admin.AdministrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="MasterListStyle" TargetType="ListView">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="4" />
        </Style>
    </Page.Resources>
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Administration" Style="{StaticResource TitleTextBlockStyle}" />

        <Pivot Grid.Row="1">

            <PivotItem Header="Benutzer">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListView Grid.Column="0" Style="{StaticResource MasterListStyle}" ItemsSource="{x:Bind ViewModel.BenutzerListe, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.BenutzerAusgewaehlt, Mode=TwoWay}" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" Padding="4">
                                    <TextBlock Text="{Binding Benutzername}" />
                                    <TextBlock Text="{Binding Anzeigename}" Opacity="0.7" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Column="1" Spacing="12">
                        <InfoBar IsOpen="{x:Bind ViewModel.BenutzerFehler, Mode=OneWay, Converter={StaticResource StringNotEmptyToBoolConverter}}" Severity="Error" Title="Fehler" Message="{x:Bind ViewModel.BenutzerFehler, Mode=OneWay}" />
                        <TextBox Header="Benutzername *" Text="{x:Bind ViewModel.BenutzerBenutzername, Mode=TwoWay}" />
                        <TextBox Header="Anzeigename *" Text="{x:Bind ViewModel.BenutzerAnzeigename, Mode=TwoWay}" />
                        <TextBox Header="E-Mail" Text="{x:Bind ViewModel.BenutzerEmail, Mode=TwoWay}" />
                        <ComboBox Header="Rolle *" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.RollenListe, Mode=OneWay}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{x:Bind ViewModel.BenutzerRolleId, Mode=TwoWay}" />
                        <PasswordBox x:Name="BenutzerNeuesPasswortBox" Header="Neues Passwort (bei Neuanlage Pflicht, sonst nur bei Änderung ausfüllen)" PasswordChanged="BenutzerNeuesPasswortBox_PasswordChanged" />
                        <CheckBox Content="Aktiv" IsChecked="{x:Bind ViewModel.BenutzerAktiv, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Neu" Command="{x:Bind ViewModel.BenutzerNeuCommand}" />
                            <Button Content="Speichern" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.BenutzerSpeichernCommand}" />
                            <Button Content="Löschen" Command="{x:Bind ViewModel.BenutzerLoeschenCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </PivotItem>

            <PivotItem Header="Rollen">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListView Grid.Column="0" Style="{StaticResource MasterListStyle}" ItemsSource="{x:Bind ViewModel.RollenListe, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.RolleAusgewaehlt, Mode=TwoWay}" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="12" Padding="4">
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Column="1" Spacing="12">
                        <InfoBar IsOpen="{x:Bind ViewModel.RolleFehler, Mode=OneWay, Converter={StaticResource StringNotEmptyToBoolConverter}}" Severity="Error" Title="Fehler" Message="{x:Bind ViewModel.RolleFehler, Mode=OneWay}" />
                        <TextBox Header="Name *" Text="{x:Bind ViewModel.RolleName, Mode=TwoWay}" />
                        <TextBox Header="Beschreibung" Text="{x:Bind ViewModel.RolleBeschreibung, Mode=TwoWay}" />
                        <TextBlock Text="Rechte" Opacity="0.7" />
                        <CheckBox Content="Stammdaten" IsChecked="{x:Bind ViewModel.RechtStammdaten, Mode=TwoWay}" />
                        <CheckBox Content="Verkauf" IsChecked="{x:Bind ViewModel.RechtVerkauf, Mode=TwoWay}" />
                        <CheckBox Content="Einkauf" IsChecked="{x:Bind ViewModel.RechtEinkauf, Mode=TwoWay}" />
                        <CheckBox Content="Lager" IsChecked="{x:Bind ViewModel.RechtLager, Mode=TwoWay}" />
                        <CheckBox Content="Finanzen" IsChecked="{x:Bind ViewModel.RechtFinanzen, Mode=TwoWay}" />
                        <CheckBox Content="Reporting" IsChecked="{x:Bind ViewModel.RechtReporting, Mode=TwoWay}" />
                        <CheckBox Content="Administration" IsChecked="{x:Bind ViewModel.RechtAdministration, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Neu" Command="{x:Bind ViewModel.RolleNeuCommand}" />
                            <Button Content="Speichern" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.RolleSpeichernCommand}" />
                            <Button Content="Löschen" Command="{x:Bind ViewModel.RolleLoeschenCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </PivotItem>

            <PivotItem Header="AuditLog">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <TextBox Width="300" PlaceholderText="Entität filtern (z. B. Kunde, Rechnung, Benutzer)" Text="{x:Bind ViewModel.AuditFilterEntityName, Mode=TwoWay}" />
                        <Button Content="Aktualisieren" Command="{x:Bind ViewModel.AuditLogLadenCommand}" />
                    </StackPanel>

                    <ListView Grid.Row="1" Style="{StaticResource MasterListStyle}" ItemsSource="{x:Bind ViewModel.AuditLogListe, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="16" Padding="4">
                                    <TextBlock Text="{Binding Zeitpunkt}" Width="160" />
                                    <TextBlock Text="{Binding BenutzerName}" Width="120" />
                                    <TextBlock Text="{Binding EntityName}" Width="140" />
                                    <TextBlock Text="{Binding EntityId}" Width="60" />
                                    <TextBlock Text="{Binding Aktion}" Width="80" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

        </Pivot>
    </Grid>
</Page>
