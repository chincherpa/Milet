<Page
    x:Class="Milet.App.Views.Reporting.ReportingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Reporting" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <CalendarDatePicker Header="Von" Date="{x:Bind ViewModel.Von, Mode=TwoWay, Converter={StaticResource DateOnlyToDateTimeOffsetConverter}}" />
            <CalendarDatePicker Header="Bis" Date="{x:Bind ViewModel.Bis, Mode=TwoWay, Converter={StaticResource DateOnlyToDateTimeOffsetConverter}}" />
        </StackPanel>

        <InfoBar Grid.Row="2"
            IsOpen="{x:Bind ViewModel.Fehlermeldung, Mode=OneWay, Converter={StaticResource StringNotEmptyToBoolConverter}}"
            Severity="Error" Title="Fehler" Message="{x:Bind ViewModel.Fehlermeldung, Mode=OneWay}" />

        <Pivot Grid.Row="3">

            <PivotItem Header="Umsatz je Kunde">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <Button Content="Laden" Command="{x:Bind ViewModel.UmsatzJeKundeLadenCommand}" />
                        <Button Content="CSV-Export" Command="{x:Bind ViewModel.UmsatzJeKundeExportierenCommand}" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.UmsatzJeKundeListe, Mode=OneWay}">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="8,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" /><ColumnDefinition Width="100" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Kunde" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Anzahl" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Netto" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Brutto" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" /><ColumnDefinition Width="100" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding KundeName}" />
                                    <TextBlock Grid.Column="1" Text="{Binding AnzahlRechnungen}" />
                                    <TextBlock Grid.Column="2" Text="{Binding SummeNetto}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SummeBrutto}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Umsatz je Artikel">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <Button Content="Laden" Command="{x:Bind ViewModel.UmsatzJeArtikelLadenCommand}" />
                        <Button Content="CSV-Export" Command="{x:Bind ViewModel.UmsatzJeArtikelExportierenCommand}" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.UmsatzJeArtikelListe, Mode=OneWay}">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="8,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" /><ColumnDefinition Width="220" /><ColumnDefinition Width="100" /><ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Artikelnr." FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Bezeichnung" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Menge" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Netto" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" /><ColumnDefinition Width="220" /><ColumnDefinition Width="100" /><ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ArtikelNummer}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Bezeichnung}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Menge}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SummeNetto}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Umsatz je Monat">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <Button Content="Laden" Command="{x:Bind ViewModel.UmsatzJeMonatLadenCommand}" />
                        <Button Content="CSV-Export" Command="{x:Bind ViewModel.UmsatzJeMonatExportierenCommand}" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.UmsatzJeMonatListe, Mode=OneWay}">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="8,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" /><ColumnDefinition Width="80" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Jahr" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Monat" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Netto" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Brutto" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" /><ColumnDefinition Width="80" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Jahr}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Monat}" />
                                    <TextBlock Grid.Column="2" Text="{Binding SummeNetto}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SummeBrutto}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Artikelbewegungen">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <Button Content="Laden" Command="{x:Bind ViewModel.ArtikelbewegungenLadenCommand}" />
                        <Button Content="CSV-Export" Command="{x:Bind ViewModel.ArtikelbewegungenExportierenCommand}" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.ArtikelbewegungenListe, Mode=OneWay}">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="8,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" /><ColumnDefinition Width="220" /><ColumnDefinition Width="80" /><ColumnDefinition Width="80" /><ColumnDefinition Width="100" /><ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Zeitpunkt" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Artikel" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Lagerort" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Menge" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Typ" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5" Text="Beleg" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" /><ColumnDefinition Width="220" /><ColumnDefinition Width="80" /><ColumnDefinition Width="80" /><ColumnDefinition Width="100" /><ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Zeitpunkt}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ArtikelBezeichnung}" />
                                    <TextBlock Grid.Column="2" Text="{Binding LagerortCode}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Menge}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Typ}" />
                                    <TextBlock Grid.Column="5" Text="{Binding BelegNummer}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Top-Artikel">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <Button Content="Laden" Command="{x:Bind ViewModel.TopArtikelLadenCommand}" />
                        <Button Content="CSV-Export" Command="{x:Bind ViewModel.TopArtikelExportierenCommand}" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.TopArtikelListe, Mode=OneWay}">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="8,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" /><ColumnDefinition Width="220" /><ColumnDefinition Width="100" /><ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Artikelnr." FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Bezeichnung" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Menge" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Netto" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" /><ColumnDefinition Width="220" /><ColumnDefinition Width="100" /><ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ArtikelNummer}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Bezeichnung}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Menge}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SummeNetto}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Offene Aufträge">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <Button Content="Laden" Command="{x:Bind ViewModel.OffeneAuftraegeLadenCommand}" />
                        <Button Content="CSV-Export" Command="{x:Bind ViewModel.OffeneAuftraegeExportierenCommand}" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.OffeneAuftraegeListe, Mode=OneWay}">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="8,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" /><ColumnDefinition Width="100" /><ColumnDefinition Width="220" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Belegnummer" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Datum" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Kunde" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Brutto" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Offene Menge" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" /><ColumnDefinition Width="100" /><ColumnDefinition Width="220" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding BelegNummer}" />
                                    <TextBlock Grid.Column="1" Text="{Binding BelegDatum}" />
                                    <TextBlock Grid.Column="2" Text="{Binding KundeName}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SummeBrutto}" />
                                    <TextBlock Grid.Column="4" Text="{Binding OffeneMenge}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Kulturbestand">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <ComboBox Header="Feld" Width="180" ItemsSource="{x:Bind ViewModel.Felder, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.KulturbestandFeldFilterId, Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="Bezeichnung" PlaceholderText="Alle" />
                        <ComboBox Header="Kulturstufe" Width="180" ItemsSource="{x:Bind ViewModel.Kulturstufen, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.KulturbestandStufeFilterId, Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="Bezeichnung" PlaceholderText="Alle" />
                        <Button Content="Laden" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.KulturbestandLadenCommand}" />
                        <Button Content="CSV-Export" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.KulturbestandExportierenCommand}" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.KulturbestandListe, Mode=OneWay}">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="8,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" /><ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Bezeichnung" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Feld" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Sektion" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Kulturstufe" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Menge" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" /><ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Bezeichnung}" />
                                    <TextBlock Grid.Column="1" Text="{Binding FeldBezeichnung}" />
                                    <TextBlock Grid.Column="2" Text="{Binding SektionBezeichnung}" />
                                    <TextBlock Grid.Column="3" Text="{Binding KulturstufeBezeichnung}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Menge}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Ausfallquote">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <Button Content="Laden" Command="{x:Bind ViewModel.AusfallquoteLadenCommand}" />
                        <Button Content="CSV-Export" Command="{x:Bind ViewModel.AusfallquoteExportierenCommand}" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.AusfallquoteListe, Mode=OneWay}">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="8,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" /><ColumnDefinition Width="200" /><ColumnDefinition Width="140" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Artikelnr." FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Bezeichnung" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Kulturstufe" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Zugänge" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Ausfall" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5" Text="Quote %" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" /><ColumnDefinition Width="200" /><ColumnDefinition Width="140" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Artikelnummer}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Bezeichnung}" />
                                    <TextBlock Grid.Column="2" Text="{Binding KulturstufeBezeichnung}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SummeZugaenge}" />
                                    <TextBlock Grid.Column="4" Text="{Binding SummeAusfall}" />
                                    <TextBlock Grid.Column="5" Text="{Binding AusfallquoteProzent}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Flächenbelegung">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <Button Content="Laden" Command="{x:Bind ViewModel.FlaechenbelegungLadenCommand}" />
                        <Button Content="CSV-Export" Command="{x:Bind ViewModel.FlaechenbelegungExportierenCommand}" />
                    </StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.FlaechenbelegungListe, Mode=OneWay}">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="8,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" /><ColumnDefinition Width="140" /><ColumnDefinition Width="140" /><ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Feld" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Gesamtfläche m²" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Belegte Fläche m²" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Belegung %" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" /><ColumnDefinition Width="140" /><ColumnDefinition Width="140" /><ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding FeldBezeichnung}" />
                                    <TextBlock Grid.Column="1" Text="{Binding GesamtflaecheQm}" />
                                    <TextBlock Grid.Column="2" Text="{Binding BelegteFlaecheQm}" />
                                    <TextBlock Grid.Column="3" Text="{Binding BelegungsProzent}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

        </Pivot>
    </Grid>
</Page>
