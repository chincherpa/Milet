<Page
    x:Class="Milet.App.Shell.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <NavigationView
        x:Name="NavView"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Left"
        SelectionChanged="NavView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Dashboard" Tag="dashboard" Icon="Home" IsSelected="True" />
            <NavigationViewItemSeparator />
            <NavigationViewItem Content="Stammdaten" Tag="stammdaten" Icon="ContactInfo" IsEnabled="False" />
            <NavigationViewItem Content="Verkauf" Tag="verkauf" Icon="Shop" IsEnabled="False" />
            <NavigationViewItem Content="Einkauf" Tag="einkauf" Icon="Import" IsEnabled="False" />
            <NavigationViewItem Content="Lager" Tag="lager" Icon="Library" IsEnabled="False" />
            <NavigationViewItem Content="Finanzen" Tag="finanzen" Icon="Calculator" IsEnabled="False" />
            <NavigationViewItem Content="Reporting" Tag="reporting" Icon="ReportHacked" IsEnabled="False" />
            <NavigationViewItem Content="Administration" Tag="admin" Icon="Setting" IsEnabled="False" />
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>
